PORT=5000
NODE_ENV=development

DATABASE_URL="postgresql://postgres:123456@localhost:5432/ecommerce?schema=public"
# Direct Postgres for migrations. Use this when DATABASE_URL points at PgBouncer.
DIRECT_URL=
# Connections this process may open. Keep this small when several API instances share one database.
DATABASE_POOL_MAX=10
# Optional. Without it, catalog and product reads go straight to Postgres.
REDIS_URL=redis://127.0.0.1:6379

ADMIN_EMAIL=anondo554@gmail.com
ADMIN_PASSWORD=12345678
ADMIN_FIRST_NAME=Anondo
ADMIN_LAST_NAME=Admin

JWT_SECRET=your-jwt-secret-min-10-chars
JWT_EXPIRES_IN=7d

JWT_REFRESH_SECRET=your-refresh-secret-min-10-chars
JWT_REFRESH_EXPIRES_IN=30d

ALLOWED_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000

GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret

COOKIE_SECRET=your-cookie-secret-min-10-chars

STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
SMTP_FROM="Store <orders@example.com>"
