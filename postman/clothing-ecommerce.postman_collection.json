    {
      "name": "Products",
      "item": [
        {
          "name": "List products",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "const items = json.data || [];",
                  "const item = items.find((product) => product.variants && product.variants.length) || items[0];",
                  "if (!item) return;",
                  "pm.collectionVariables.set('productId', item.id);",
                  "if (item.brand) pm.collectionVariables.set('brandId', item.brand.id);",
                  "if (item.category) pm.collectionVariables.set('categoryId', item.category.id);",
                  "const variant = item.variants && item.variants[0];",
                  "if (!variant) return;",
                  "pm.collectionVariables.set('variantId', variant.id);",
                  "if (variant.size) pm.collectionVariables.set('sizeId', variant.size.id);",
                  "if (variant.fabric) pm.collectionVariables.set('fabricId', variant.fabric.id);"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/products?page=1&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "products"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "20" },
                { "key": "search", "value": "", "disabled": true },
                { "key": "status", "value": "ACTIVE", "disabled": true },
                { "key": "gender", "value": "MEN", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "Get product",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "const product = json.data;",
                  "if (!product) return;",
                  "pm.collectionVariables.set('productId', product.id);",
                  "const variant = product.variants && product.variants[0];",
                  "if (!variant) return;",
                  "pm.collectionVariables.set('variantId', variant.id);",
                  "if (variant.size) pm.collectionVariables.set('sizeId', variant.size.id);",
                  "if (variant.color) pm.collectionVariables.set('colorId', variant.color.id);",
                  "if (variant.fabric) pm.collectionVariables.set('fabricId', variant.fabric.id);"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/products/{{productId}}"
          }
        },
        {
          "name": "Create product",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "const product = json.data;",
                  "if (!product) return;",
                  "pm.collectionVariables.set('productId', product.id);",
                  "const variant = product.variants && product.variants[0];",
                  "if (!variant) return;",
