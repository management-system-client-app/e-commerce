                  "if (data.sizes && data.sizes[0]) pm.collectionVariables.set('sizeId', data.sizes[0].id);",
                  "if (data.fabrics && data.fabrics[0]) pm.collectionVariables.set('fabricId', data.fabrics[0].id);"
